 extern crate alloc;
+
+// Compile string formatting with this crate's panic strategy instead of the
+// prebuilt alloc formatter, whose Windows implementation carries CRT unwind glue.
+macro_rules! format {
+    ($($arguments:tt)*) => {{
+        let mut output = alloc::string::String::new();
+        core::fmt::write(&mut output, core::format_args!($($arguments)*))
+            .expect("a formatting trait implementation returned an error");
+        output
+    }};
+}
