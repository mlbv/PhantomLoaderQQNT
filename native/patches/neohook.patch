+// Copyright (c) 2026 NeoHook Authors
+// SPDX-License-Identifier: MIT OR Apache-2.0
+#![no_std]
+
+extern crate alloc;
+
+#[cfg(not(all(windows, target_arch = "x86_64")))]
+compile_error!("This NeoHook core requires Windows x64");
+
+mod code;
+pub mod disasm;
+pub mod unwind;
+
+pub use code::resolve;
+
+/// Memory reads must remain valid for the duration of each algorithm call.
+/// Implementations must report unreadable memory without dereferencing it.
+pub unsafe trait Memory {
+    unsafe fn read<T: Copy>(address: *const u8) -> Result<T, u32>;
+    /// Returns readable bytes bounded by the committed region containing `address`.
+    /// Query failures and guarded or unreadable pages return zero; reading a guard
+    /// page would consume the guard and raise STATUS_GUARD_PAGE_VIOLATION.
+    unsafe fn readable_bytes(address: *const u8) -> usize;
+}
